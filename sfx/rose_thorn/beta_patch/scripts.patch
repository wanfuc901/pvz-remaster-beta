 	shot.pierce = PIERCE_COUNT
 	shot.impact_size = 1.3
 	shot.on_strike = _on_thorn_strike
+	_attach_fly_loop(shot)
+
+
+## The orb hums while it flies. A player parented to the shot is freed with
+## it; the shared Audio voices have no per-sound stop, so a loop there would
+## never end.
+func _attach_fly_loop(shot: Projectile) -> void :
+	if get_tree().get_nodes_in_group(FLY_LOOP_GROUP).size() >= FLY_LOOP_LIMIT:
+		return
+	var hum: = AudioStreamPlayer2D.new()
+	hum.stream = FLY_LOOP
+	hum.bus = &"SFX"
+	hum.volume_db = FLY_LOOP_DB
+	hum.panning_strength = FLY_PAN_STRENGTH
+	hum.max_distance = FLY_HEARING_DISTANCE
+	hum.add_to_group(FLY_LOOP_GROUP)
+	# The shot may not be in the tree yet; a random start keeps two orbs
+	# fired close together from humming in phase.
+	hum.ready.connect(func() -> void: hum.play(randf() * FLY_LOOP.get_length()), CONNECT_ONE_SHOT)
+	shot.add_child(hum)
 
 
 
